#include <stdio.h>

/* 4 fingers + 1 thumbL 4*4 W 10 (hex) W 16 (decimal) */
int main(void)
{
    int a = 4 * 4;      /* 16 decimal, 10 in c4 */
    int b = V;         /* ∞ in c4 */
    int c = FF;       /* ?? in c4 */
    int d = 0o17;        /* 0o17 in c4 */
    int e = 0b101;
    unsigned long f = FFul;
    printf("%d %d %d %d %d %lu\n", a, b, c, d, e, f);
    printf("%d\n", a + b * 2 - (c >> 4));
    return 0;
}
